{
  "name": "lineage-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "publish:site": "vite build && node -e \"const fs=require('fs');const d=process.env.SITE_DIR||'../davidgiang-site';fs.rmSync(d+'/lineage',{recursive:true,force:true});fs.cpSync('dist',d+'/lineage',{recursive:true})\""
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "vite": "^5.4.0"
  }
}
